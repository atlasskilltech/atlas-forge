{
  "name": "atlas-forge",
  "version": "0.1.0",
  "private": true,
  "description": "ATLAS Forge - The Product Development Centre for ATLAS SkillTech University",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check:tables": "node scripts/check-table-names.mjs",
    "db:check": "node --env-file=.env scripts/check-db.mjs",
    "db:investigate": "node --env-file=.env scripts/investigate-prefix.mjs",
    "db:prefix": "node --env-file=.env scripts/migrate-forge-prefix.mjs",
    "db:queries": "node --no-warnings --env-file=.env scripts/verify-queries.mjs",
    "db:schema": "node --env-file=.env scripts/apply-schema.mjs",
    "db:reference": "node --env-file=.env scripts/apply-sql.mjs reference-data.sql",
    "db:seed": "node --env-file=.env scripts/apply-sql.mjs seed.sql",
    "db:migrate": "node --env-file=.env scripts/apply-sql.mjs",
    "db:verify": "node --env-file=.env scripts/verify-schema.mjs",
    "smtp:verify": "node --env-file=.env scripts/verify-smtp.mjs",
    "db:test": "node --env-file=.env scripts/verify-data-layer.mjs",
    "test:student": "node --env-file=.env scripts/verify-student-module.mjs",
    "test:student:api": "node --env-file=.env scripts/verify-student-api.mjs",
    "test:student:browser": "python scripts/verify-student-browser.py",
    "test:founder": "node --env-file=.env scripts/verify-founder-module.mjs",
    "test:founder:api": "node --env-file=.env scripts/verify-founder-api.mjs",
    "test:founder:browser": "python scripts/verify-founder-browser.py",
    "test:forge": "node --env-file=.env scripts/verify-forge-module.mjs",
    "test:forge:api": "node --env-file=.env scripts/verify-forge-api.mjs",
    "test:forge:browser": "python scripts/verify-forge-browser.py",
    "test:backend": "node --env-file=.env scripts/verify-backend-module.mjs",
    "test:backend:api": "node --env-file=.env scripts/verify-backend-api.mjs",
    "test:backend:browser": "python scripts/verify-backend-browser.py",
    "test:admin": "node --env-file=.env scripts/verify-admin-module.mjs",
    "test:admin:api": "node --env-file=.env scripts/verify-admin-api.mjs",
    "test:admin:browser": "python scripts/verify-admin-browser.py",
    "test:phase3": "node --env-file=.env scripts/verify-phase3-api.mjs",
    "test:security": "node --env-file=.env scripts/verify-security.mjs",
    "test:errors": "node --env-file=.env scripts/verify-errors.mjs",
    "test:pagination": "node --env-file=.env scripts/verify-pagination.mjs",
    "test:student-verification": "node --env-file=.env scripts/verify-student-verification.mjs",
    "test:student-activity": "node --env-file=.env scripts/verify-student-activity.mjs",
    "test:auth:google": "node --env-file=.env scripts/verify-google-auth.mjs",
    "db:reset": "npm run db:schema -- --force && npm run db:reference && npm run db:seed"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "google-auth-library": "^11.3.4",
    "mysql2": "^3.23.2",
    "next": "^16.0.0",
    "nodemailer": "^10.0.15",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "eslint": "^9.37.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.1.14"
  }
}
