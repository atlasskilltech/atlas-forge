# ---------------------------------------------------------------------------
# ATLAS Forge — environment template
#
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored and
# must never be committed. Moving to another MySQL server should require
# changing ONLY this file — no application code.
# ---------------------------------------------------------------------------

# Public site URL, used for canonical URLs, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Session --------------------------------------------------------------
# Signs the session cookie. REQUIRED — the app refuses to start without it, so
# no deployment can accidentally fall back to a shared, forgeable default.
# Generate a distinct value per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_COOKIE_NAME=atlas_forge_session
SESSION_TTL_HOURS=12

# ---- MySQL ----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=atlas-forge-dashboard

# Connection pool. Raise DB_CONNECTION_LIMIT on servers with more concurrency.
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT_MS=10000

# Set to `true` when the server requires TLS (most managed MySQL providers do).
DB_SSL=false
# Optional CA certificate contents for providers that need one (PlanetScale,
# Aiven, RDS with a custom CA). Leave blank to use the system trust store.
DB_SSL_CA=

# Logs every SQL statement with its duration. Never enable in production.
DB_DEBUG=false

# ---- Uploads --------------------------------------------------------------
# Where uploaded files (startup logos) are written. Optional: defaults to
# `uploads/` inside the application directory, which is enough to run.
#
# In production set it to an absolute path OUTSIDE the deployed directory. A
# logo exists nowhere else, so if it lives in the folder a deploy replaces, the
# next release deletes every logo ever uploaded. The Node process must be able
# to write to it.
#
#   UPLOAD_DIR=/home/<cpanel-user>/atlas-forge-uploads
UPLOAD_DIR=

# Largest single upload, in bytes. Defaults to 2MB.
UPLOAD_MAX_BYTES=2097152

# ---- Authentication rate limiting -----------------------------------------
# Counted per App ID and per client address over a rolling window. Only failed
# attempts count, and a correct password clears the streak.
#
# Set either maximum to 0 to disable that counter — the automated suites do
# exactly that, because they fail sign-in on purpose many times per run.
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=8
AUTH_RATE_LIMIT_IP_MAX_ATTEMPTS=40
# How long attempt rows are kept for audit before the retention sweep drops them.
AUTH_RATE_LIMIT_RETENTION_HOURS=72
